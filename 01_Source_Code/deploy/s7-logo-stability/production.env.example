# Copy to /etc/s7-logo/production.env on the ECS and keep it root-only.
S7_AI_CONFIG=/etc/s7-logo/ai-provider.json
PORT=3210
HOST=127.0.0.1
APP_DATA_DIR=/var/lib/s7-logo/workspace
APP_NO_SEED=1
APP_ALLOWED_HOSTS=logo.heciai.net,127.0.0.1,localhost
APP_MULTI_USER=1
APP_PUBLIC_ORIGIN=https://logo.heciai.net
S7_WORKSPACE_URL=http://127.0.0.1:3210
S7_SPACE_DIR=/var/lib/s7-logo/workspace/user-spaces
